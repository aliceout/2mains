{
  "name": "2mains",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:web": "astro dev",
    "dev:api": "pnpm --dir services/payload dev",
    "dev:mail": "pnpm --dir services/mail dev",
    "build": "astro build",
    "build:web": "astro build",
    "build:api": "pnpm --dir services/payload build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "a11y": "node scripts/a11y-audit.mjs",
    "a11y:deep": "node scripts/a11y-deep.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,js,json,md}\" \"*.{md,mjs,ts,json}\"",
    "lint": "eslint \"src/**/*.{astro,ts,tsx,js}\"",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "astro": "^7.3.3",
    "marked": "^18.0.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/nunito": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.1",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.2.1",
    "htmlparser2": "^12.0.0",
    "husky": "^9.1.7",
    "playwright": "^1.63.0",
    "prettier": "^3.9.7",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "yaml@<2.8.3": ">=2.8.3"
    }
  }
}
