---
import Layout from '../layouts/Layout.astro';
import PageRenderer from '../components/PageRenderer.astro';
import MissingPageFallback from '../components/MissingPageFallback.astro';
import { fetchPageLegacy } from '../lib/payload';

const page = await fetchPageLegacy('accueil');
const hasContent =
  Boolean(page?.data.hero?.titre) || Boolean(page?.data.sections?.length);
const fallbackTitle = 'Accueil';
---

<Layout
  title={hasContent && page ? undefined : fallbackTitle}
  ogSlug="accueil"
>
  {page && hasContent ? <PageRenderer page={page} /> : <MissingPageFallback title={fallbackTitle} />}
</Layout>
