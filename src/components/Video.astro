---
// Embed vidéo YouTube / Vimeo en « click-to-load » : tant que le visiteur
// ne clique pas sur ▶, on n'affiche qu'une image d'aperçu + un bouton —
// AUCUN cookie ni script tiers n'est chargé (RGPD-friendly, cohérent avec
// le refus des outils Google côté projet). Au clic, on injecte l'iframe.
//
// Plateforme + id détectés depuis l'URL collée par Audrey. Miniature :
// URL image directe pour YouTube ; oEmbed (fetch SSR) pour Vimeo.

type Props = {
  url: string;
  legende?: string;
};

const { url, legende } = Astro.props;

type Parsed = { platform: 'youtube' | 'vimeo'; id: string } | null;

function parseUrl(raw: string): Parsed {
  if (!raw) return null;
  let u: URL;
  try {
    u = new URL(raw.trim());
  } catch {
    return null;
  }
  const host = u.hostname.replace(/^www\./, '');

  // YouTube : youtu.be/<id>, youtube.com/watch?v=<id>, /embed/<id>, /shorts/<id>
  if (host === 'youtu.be') {
    const id = u.pathname.slice(1).split('/')[0];
    return id ? { platform: 'youtube', id } : null;
  }
  if (host === 'youtube.com' || host === 'youtube-nocookie.com' || host === 'm.youtube.com') {
    const v = u.searchParams.get('v');
    if (v) return { platform: 'youtube', id: v };
    const m = u.pathname.match(/\/(embed|shorts)\/([^/?]+)/);
    if (m) return { platform: 'youtube', id: m[2] };
    return null;
  }

  // Vimeo : vimeo.com/<id>, player.vimeo.com/video/<id>
  if (host === 'vimeo.com' || host === 'player.vimeo.com') {
    const m = u.pathname.match(/(?:\/video)?\/(\d+)/);
    return m ? { platform: 'vimeo', id: m[1] } : null;
  }

  return null;
}

const parsed = parseUrl(url);

// Miniature d'aperçu.
let thumb: string | null = null;
let embedSrc = '';

if (parsed?.platform === 'youtube') {
  // URL image directe (pas de cookie ; juste une requête image au CDN).
  thumb = `https://i.ytimg.com/vi/${parsed.id}/hqdefault.jpg`;
  // Domaine nocookie + autoplay au clic (l'utilisateur a déjà cliqué).
  embedSrc = `https://www.youtube-nocookie.com/embed/${parsed.id}?autoplay=1&rel=0`;
} else if (parsed?.platform === 'vimeo') {
  embedSrc = `https://player.vimeo.com/video/${parsed.id}?autoplay=1`;
  // Vimeo n'a pas d'URL image directe : on demande la miniature via oEmbed
  // (fetch SSR au render, sans clé API). Si ça échoue, fallback placeholder.
  try {
    const res = await fetch(
      `https://vimeo.com/api/oembed.json?url=${encodeURIComponent(`https://vimeo.com/${parsed.id}`)}`,
    );
    if (res.ok) {
      const data = (await res.json()) as { thumbnail_url?: string };
      thumb = data.thumbnail_url ?? null;
    }
  } catch {
    thumb = null;
  }
}
---

{
  parsed ? (
    <figure class="mx-auto max-w-3xl">
      <div
        class="video-embed relative aspect-video overflow-hidden rounded-2xl bg-ink"
        data-embed-src={embedSrc}
        data-platform={parsed.platform}
      >
        <button
          type="button"
          class="video-embed__btn group absolute inset-0 flex h-full w-full items-center justify-center"
          aria-label="Lire la vidéo"
        >
          {thumb && (
            <img
              src={thumb}
              alt=""
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover"
            />
          )}
          <span class="absolute inset-0 bg-ink/30 transition-colors group-hover:bg-ink/40"></span>
          <span class="relative flex h-16 w-16 items-center justify-center rounded-full bg-paper/95 shadow-lg transition-transform group-hover:scale-110">
            <svg width="22" height="26" viewBox="0 0 22 26" fill="none" aria-hidden="true">
              <path d="M21 13L0.75 24.6913L0.75 1.30866L21 13Z" fill="#2f4d53" />
            </svg>
          </span>
        </button>
      </div>
      {legende && (
        <figcaption class="mt-3 text-center font-serif italic text-[15px] text-ink-3">
          {legende}
        </figcaption>
      )}
    </figure>
  ) : (
    <p class="mx-auto max-w-3xl rounded-md bg-peach px-4 py-3 text-sm text-ink-2">
      ⚠️ Lien vidéo non reconnu. Colle une URL YouTube ou Vimeo valide.
    </p>
  )
}

<script>
  // Click-to-load : au clic sur l'aperçu, on remplace la façade par
  // l'iframe (chargement du lecteur tiers seulement à cet instant).
  document.querySelectorAll<HTMLElement>('.video-embed').forEach((el) => {
    const btn = el.querySelector<HTMLButtonElement>('.video-embed__btn');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const src = el.dataset.embedSrc;
      if (!src) return;
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.className = 'absolute inset-0 h-full w-full';
      iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
      iframe.setAttribute('allowfullscreen', 'true');
      iframe.setAttribute('title', 'Lecteur vidéo');
      el.replaceChildren(iframe);
    });
  });
</script>
