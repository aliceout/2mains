---
import { filterPublished } from '../lib/drafts';
import { fetchCollectionLegacy, type LegacyPage } from '../lib/payload';
import { lexicalToHtml } from '../lib/lexical';
import Hero from './Hero.astro';
import Section from './Section.astro';
import Prose from './Prose.astro';
import BlocCartes from './BlocCartes.astro';
import BlocValeurs from './BlocValeurs.astro';
import BlocStat from './BlocStat.astro';
import BlocCitation from './BlocCitation.astro';
import Etapes from './Etapes.astro';
import DeuxColonnes from './DeuxColonnes.astro';
import Faq from './Faq.astro';
import Callout from './Callout.astro';
import ChiffreDetail from './ChiffreDetail.astro';
import Formats from './Formats.astro';
import CitationLarge from './CitationLarge.astro';
import TextePhoto from './TextePhoto.astro';
import Figure from './Figure.astro';
import Galerie from './Galerie.astro';
import BandeauImage from './BandeauImage.astro';
import Portraits from './Portraits.astro';
import Timeline from './Timeline.astro';
import Lettre from './Lettre.astro';
import StatMajeste from './StatMajeste.astro';
import Temoignages from './Temoignages.astro';
import SoutenirHome from './SoutenirHome.astro';
import Video from './Video.astro';
import PartenairesListe from './PartenairesListe.astro';
import Draft from './Draft.astro';

type Props = {
  page: LegacyPage;
};

const { page } = Astro.props;
const { hero, sections } = page.data;

// Si l'une des sections est de type `equipe`, on charge la collection
// pour la rendre en portraits.
const needsEquipe = sections.some((s) => s.type === 'equipe');
const equipeMembres = needsEquipe
  ? filterPublished(
      await fetchCollectionLegacy<{
        nom: string;
        role: string;
        photo?: string;
        bio_courte?: string;
        linkedin?: string;
        ordre?: number;
        draft?: boolean;
      }>('equipe', { sort: 'ordre' }),
    )
  : [];

// Pour le bloc soutenir-home (page d'accueil), on a besoin des prochains
// événements à venir pour la colonne droite. 3 max, filtrés par date future.
const needsAVenir = sections.some((s) => s.type === 'soutenir-home');
const aVenir = needsAVenir
  ? filterPublished(
      await fetchCollectionLegacy<{
        title: string;
        date_debut: string;
        lieu: string;
        fictif?: boolean;
        draft?: boolean;
      }>('evenements', { sort: 'date_debut' }),
    )
      .filter((e) => Date.parse(e.data.date_debut) >= Date.now())
      .slice(0, 3)
  : [];

// Pour le bloc liste-partenaires : on charge la collection Partenaires
// (groupée par type côté composant). logo/url résolus par fetchCollectionLegacy.
const needsPartenaires = sections.some((s) => s.type === 'liste-partenaires');
const partenaires = needsPartenaires
  ? filterPublished(
      await fetchCollectionLegacy<{
        nom: string;
        type: string;
        logo?: string;
        url?: string;
        description_courte?: string;
        ordre?: number;
        draft?: boolean;
      }>('partenaires', { sort: 'ordre' }),
    )
  : [];

// Idem pour les témoignages.
const needsTemoignages = sections.some((s) => s.type === 'temoignages');
const tousTemoignages = needsTemoignages
  ? filterPublished(
      await fetchCollectionLegacy<{
        auteur: string;
        role?: string;
        contexte: string;
        photo?: string;
        citation: string;
        ordre?: number;
        a_la_une?: boolean;
        fictif?: boolean;
        draft?: boolean;
      }>('temoignages', { sort: 'ordre' }),
    )
  : [];

// Ancre stable par bloc : on utilise l'id Payload du bloc (clé primaire,
// stable au renommage et au réordonnancement) préfixé `bloc-`. C'est la
// cible des liens "vers un bloc précis" construits par resolveLink
// (`#bloc-<id>`). Le menu déroulant d'ancres côté admin stocke ce même id.
const sectionIds: (string | undefined)[] = sections.map((s) => {
  const blockId = (s as { id?: string | number }).id;
  return blockId != null ? `bloc-${blockId}` : undefined;
});
---

{hero && <Hero {...hero} />}

{
  sections.map((s, i) => {
    const id = sectionIds[i];
    if (s.type === 'prose') {
      const html = lexicalToHtml(s.body_rich);
      return (
        <Section id={id} titre={s.titre} fond={s.fond}>
          <Prose>
            <Fragment set:html={html} />
          </Prose>
        </Section>
      );
    }
    if (s.type === 'cartes') {
      return (
        <Section id={id} titre={s.titre} fond={s.fond}>
          <BlocCartes cartes={s.cartes} colonnes={s.colonnes} />
        </Section>
      );
    }
    if (s.type === 'valeurs') {
      return (
        <Section id={id} titre={s.titre} fond={s.fond}>
          <BlocValeurs valeurs={s.valeurs} />
        </Section>
      );
    }
    if (s.type === 'stats') {
      const introHtml = lexicalToHtml(s.intro_rich);
      return (
        <Section id={id} titre={s.titre} fond={s.fond}>
          {introHtml && (
            <div class="mb-8 max-w-3xl text-lg leading-relaxed" set:html={introHtml} />
          )}
          <BlocStat stats={s.stats} />
        </Section>
      );
    }
    if (s.type === 'citation') {
      const inner = (
        <BlocCitation
          citation_rich={s.citation_rich}
          auteur={s.auteur}
          role={s.role}
          variant={s.variant}
        />
      );
      return (
        <Section id={id} fond={s.fond}>
          {s.fictif ? (
            <Draft reason={`Citation fictive — ${s.auteur}`}>{inner}</Draft>
          ) : (
            inner
          )}
        </Section>
      );
    }
    if (s.type === 'cta') {
      const isDark = (s.fond ?? 'violet') === 'violet' || (s.fond ?? 'violet') === 'orange' || s.fond === 'vert';
      const titreColor = isDark ? 'text-paper' : 'text-ink';
      const corpsColor = isDark ? 'text-paper/85' : 'text-ink-2';
      const corpsHtml = lexicalToHtml(s.corps_rich);
      return (
        <Section id={id} fond={s.fond ?? 'violet'}>
          <div class="grid gap-6 max-w-225">
            <h2 class:list={['font-serif text-[26px] font-normal leading-tight tracking-tight md:text-[32px]', titreColor]}>
              {s.titre}
            </h2>
            {corpsHtml && (
              <div
                class:list={[
                  'font-sans text-base leading-relaxed max-w-220',
                  corpsColor,
                  // Liens dans le corps : sur fond foncé, clair + souligné
                  // (sinon couleur par défaut illisible sur violet/orange).
                  isDark
                    ? '[&_a]:text-paper [&_a]:underline [&_a]:underline-offset-2 [&_a]:font-medium'
                    : '[&_a]:text-orange [&_a]:underline [&_a]:underline-offset-2',
                ]}
                set:html={corpsHtml}
              />
            )}
            {(s.cta_primaire?.label || s.cta_secondaire?.label) && (
              <div class="mt-2 flex flex-wrap items-center gap-3">
                {s.cta_primaire?.label && (
                  isDark ? (
                    <a
                      href={s.cta_primaire.href}
                      target={s.cta_primaire.externe ? '_blank' : undefined}
                      rel={s.cta_primaire.externe ? 'noopener' : undefined}
                      class="inline-flex items-center gap-1.5 rounded-md bg-paper px-5.5 py-3 font-sans text-sm font-medium text-ink no-underline transition-opacity hover:opacity-85"
                    >
                      {s.cta_primaire.label} <span aria-hidden="true">→</span>
                    </a>
                  ) : (
                    <a
                      href={s.cta_primaire.href}
                      target={s.cta_primaire.externe ? '_blank' : undefined}
                      rel={s.cta_primaire.externe ? 'noopener' : undefined}
                      class="inline-flex items-center gap-1.5 rounded-md bg-orange px-5.5 py-3 font-sans text-sm font-medium text-paper no-underline transition-opacity hover:opacity-85"
                    >
                      {s.cta_primaire.label} <span aria-hidden="true">→</span>
                    </a>
                  )
                )}
                {s.cta_secondaire?.label && (
                  <a
                    href={s.cta_secondaire.href}
                    target={s.cta_secondaire.externe ? '_blank' : undefined}
                    rel={s.cta_secondaire.externe ? 'noopener' : undefined}
                    class:list={[
                      'inline-flex items-center gap-1.5 rounded-md border px-5.5 py-3 font-sans text-sm font-medium no-underline transition-opacity hover:opacity-85',
                      isDark ? 'border-paper text-paper bg-transparent' : 'border-ink text-ink bg-transparent',
                    ]}
                  >
                    {s.cta_secondaire.label}
                  </a>
                )}
              </div>
            )}
          </div>
        </Section>
      );
    }
    if (s.type === 'etapes') {
      return (
        <Section id={id} titre={s.titre} fond={s.fond}>
          <Etapes etapes={s.etapes} couleur={s.couleur ?? undefined} />
        </Section>
      );
    }
    if (s.type === 'deux-colonnes') {
      return (
        <Section id={id} titre={s.titre} fond={s.fond}>
          <DeuxColonnes
            texte_rich={s.texte_rich}
            inverse={s.inverse}
            picto_couleur={s.picto_couleur}
            image={s.image}
            image_alt={s.image_alt}
          />
        </Section>
      );
    }
    if (s.type === 'faq') {
      return (
        <Section id={id} titre={s.titre} fond={s.fond}>
          <Faq questions={s.questions} />
        </Section>
      );
    }
    if (s.type === 'callout') {
      return (
        <Section id={id} fond={s.fond}>
          <Callout
            ton={s.ton}
            titre={s.titre}
            body_rich={s.body_rich}
          />
        </Section>
      );
    }
    if (s.type === 'chiffre-detail') {
      return (
        <Section id={id} titre={s.titre} fond={s.fond}>
          <ChiffreDetail
            chiffre={s.chiffre}
            texte_rich={s.texte_rich}
            source={s.source}
            alignement={s.alignement}
            couleur={s.couleur ?? undefined}
          />
        </Section>
      );
    }
    if (s.type === 'formats') {
      return (
        <Section id={id} titre={s.titre} fond={s.fond}>
          <Formats formats={s.formats} colonnes={s.colonnes} />
        </Section>
      );
    }
    if (s.type === 'citation-large') {
      return (
        <Section id={id} fond={s.fond}>
          <CitationLarge
            citation_rich={s.citation_rich}
            auteur={s.auteur}
            role={s.role}
            variant={s.variant}
          />
        </Section>
      );
    }
    if (s.type === 'texte-photo') {
      return (
        <Section id={id} titre={s.titre} fond={s.fond}>
          <TextePhoto
            texte_rich={s.texte_rich}
            image={s.image}
            image_alt={s.image_alt}
            image_legende={s.image_legende}
            image_credit={s.image_credit}
            position={s.position}
            ratio={s.ratio}
          />
        </Section>
      );
    }
    if (s.type === 'figure') {
      return (
        <Section id={id} fond={s.fond}>
          <Figure
            image={s.image}
            alt={s.alt}
            legende={s.legende}
            credit={s.credit}
            taille={s.taille}
          />
        </Section>
      );
    }
    if (s.type === 'galerie') {
      return (
        <Section id={id} titre={s.titre} fond={s.fond}>
          <Galerie
            images={s.images}
            colonnes={s.colonnes}
            lightbox={s.lightbox}
          />
        </Section>
      );
    }
    if (s.type === 'bandeau-image') {
      // Rendu hors <Section> pour que l'image soit vraiment pleine largeur.
      return (
        <BandeauImage
          anchorId={id}
          image={s.image}
          alt={s.alt}
          titre={s.titre}
          sousTitre={s.sousTitre}
          hauteur={s.hauteur}
          position_texte={s.position_texte}
          position_verticale={s.position_verticale}
          scrim={s.scrim}
        />
      );
    }
    if (s.type === 'portraits') {
      return (
        <Section id={id} titre={s.titre} fond={s.fond}>
          <Portraits
            personnes={s.personnes}
            colonnes={s.colonnes}
            forme={s.forme}
          />
        </Section>
      );
    }
    if (s.type === 'timeline') {
      return (
        <Section id={id} titre={s.titre} fond={s.fond}>
          <Timeline etapes={s.etapes} alignement={s.alignement} />
        </Section>
      );
    }
    if (s.type === 'temoignages') {
      // `s.ids` = array d'IDs string (relations hasMany normalisées par
      // transformBlock). Vide ou absent → on tire automatiquement
      // depuis la liste complète (respecte filtre `contexte` + limite).
      let subset = s.ids && s.ids.length > 0
        ? tousTemoignages.filter((t) => s.ids!.includes(t.id))
        : tousTemoignages;
      if (s.contexte && !s.ids) {
        subset = subset.filter((t) => t.data.contexte === s.contexte);
      }
      subset = subset.slice(0, s.limite);
      if (subset.length === 0) return null;
      return (
        <Section id={id} titre={s.titre} fond={s.fond}>
          <Temoignages temoignages={subset} />
        </Section>
      );
    }
    if (s.type === 'equipe') {
      // `s.ids` = array d'IDs string (relations hasMany normalisées par
      // transformBlock). Vide ou absent → tous les membres (sortés
      // par `ordre`).
      const subset = s.ids && s.ids.length > 0
        ? equipeMembres.filter((m) => s.ids!.includes(m.id))
        : equipeMembres;
      const personnes = subset.map((m) => ({
        nom: m.data.nom,
        role: m.data.role,
        photo: m.data.photo,
        photo_alt: `Portrait de ${m.data.nom}`,
        bio_rich: m.data.bio_courte
          ? {
              root: {
                type: 'root' as const,
                children: [
                  {
                    type: 'paragraph',
                    children: [{ type: 'text', text: m.data.bio_courte }],
                  },
                ],
              },
            }
          : undefined,
        lien: m.data.linkedin,
        lien_label: m.data.linkedin ? 'LinkedIn' : undefined,
      }));
      const introHtml = lexicalToHtml(s.intro_rich);
      return (
        <Section id={id} titre={s.titre} fond={s.fond}>
          {introHtml && (
            <div
              class="mb-8 max-w-220 font-sans text-base leading-relaxed text-ink-2"
              set:html={introHtml}
            />
          )}
          <Portraits
            personnes={personnes}
            colonnes={s.colonnes}
            forme={s.forme}
          />
        </Section>
      );
    }
    if (s.type === 'lettre') {
      return (
        <Section id={id} titre={s.titre} fond={s.fond}>
          <Lettre
            corps_rich={s.corps_rich}
            ouverture={s.ouverture}
            signature={s.signature}
            variant={s.variant}
          />
        </Section>
      );
    }
    if (s.type === 'stat-majeste') {
      return (
        <Section id={id} titre={s.titre} fond={s.fond}>
          <StatMajeste
            chiffre={s.chiffre}
            texte_rich={s.texte_rich}
            source={s.source}
            eyebrow={s.eyebrow}
            variant={s.variant}
          />
        </Section>
      );
    }
    if (s.type === 'video') {
      return (
        <Section id={id} titre={s.titre} fond={s.fond}>
          <Video url={s.url} legende={s.legende} />
        </Section>
      );
    }
    if (s.type === 'liste-partenaires') {
      // Rendu hors <Section> : le composant gère ses propres 3 sections
      // (présentations distinctes par type de partenaire).
      return (
        <PartenairesListe
          id={id}
          partenaires={partenaires}
          titre_financeurs={s.titre_financeurs}
          titre_partenaires={s.titre_partenaires}
          texte_partenaires={s.texte_partenaires}
          titre_reseaux={s.titre_reseaux}
        />
      );
    }
    if (s.type === 'soutenir-home') {
      // Rendu hors <Section> : 2 colonnes pleine largeur, pas de wrap.
      return (
        <SoutenirHome
          anchorId={id}
          eyebrow={s.eyebrow}
          titre={s.titre}
          corps_rich={s.corps_rich}
          cta_primaire={s.cta_primaire}
          cta_secondaire={s.cta_secondaire}
          aVenir={aVenir}
        />
      );
    }
    return null;
  })
}
