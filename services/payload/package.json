{
  "name": "2mains-payload",
  "version": "0.1.0",
  "description": "Backend Payload CMS pour 2mains de femmes",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "dotenv -e ../../.env -- cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "devsafe": "rm -rf .next && dotenv -e ../../.env -- cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "generate:importmap": "dotenv -e ../../.env -- cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "dotenv -e ../../.env -- cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "migrate": "dotenv -e ../../.env -- cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "import:content": "dotenv -e ../../.env -- cross-env NODE_OPTIONS=--no-deprecation tsx scripts/migrate-to-payload.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3001",
    "test:auth": "cross-env NODE_OPTIONS=--no-deprecation tsx --test src/auth/auth.test.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/email-nodemailer": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/translations": "^3.89.0",
    "@payloadcms/ui": "3.89.0",
    "cross-env": "^10.1.0",
    "dotenv": "17.4.2",
    "graphql": "^16.14.2",
    "next": "16.3.5",
    "nodemailer": "^9.1.1",
    "payload": "3.89.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "yaml@<2.8.3": ">=2.8.3",
      "dompurify@<3.4.13": "^3.4.13"
    }
  }
}
